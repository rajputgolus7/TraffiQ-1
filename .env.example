# ==========================================
# TraffiQ Environment Configuration Template
# ==========================================

# --- Backend Configuration ---
# API Server settings
PORT=8000
HOST=0.0.0.0
DEBUG=True
SECRET_KEY=super_secret_key_for_jwt_auth_change_in_production

# Database Connections
DATABASE_URL=postgresql://user:password@localhost:5432/traffiq_db
MONGO_URI=mongodb://localhost:27017
REDIS_URL=redis://localhost:6379/0

# AI Pipeline Settings
YOLO_MODEL_PATH=./ml_models/weights/yolov11x.pt
REID_MODEL_PATH=./ml_models/weights/osnet_x1_0.pth
USE_GPU=True

# Demo Mode (For SIH Presentation)
DEMO_MODE=False
DEMO_DATA_PATH=./data/sih_demo_dataset

# --- Frontend Configuration ---
# API Endpoints
VITE_API_BASE_URL=http://localhost:8000/api/v1
VITE_WS_URL=ws://localhost:8000/ws/telemetry

# Map Settings (e.g., Mapbox)
VITE_MAPBOX_TOKEN=your_mapbox_access_token_here
VITE_DEFAULT_LAT=28.6139
VITE_DEFAULT_LNG=77.2090
VITE_DEFAULT_ZOOM=12
